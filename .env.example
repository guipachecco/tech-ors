# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Chave que criptografa os segredos do 2FA no banco (64 hex). Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NÃO perca nem troque: sem ela os 2FA já configurados deixam de funcionar.
TOTP_ENCRYPTION_KEY=

# --- Banco de dados (escolha UMA forma) ---
# 1) Computador: não precisa definir nada. Padrão: %LOCALAPPDATA%\TechMasterOrcamentos\orcamentos.db (fora do OneDrive)
#    Para outro arquivo:  DATABASE_PATH=D:\dados\orcamentos.db
DATABASE_PATH=
# 2) Nuvem (Vercel + Turso): veja docs/deploy.md. Na Vercel, defina estas duas nas Environment Variables.
#    (DATABASE_URL / DATABASE_AUTH_TOKEN são nomes equivalentes e têm prioridade, se definidos.)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
